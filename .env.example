# ─────────────────────────────────────────────
# ODONTO-SCAN — Environment Variables Example
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file to git.
# ─────────────────────────────────────────────

# MongoDB Connection String
# Local:  mongodb://localhost:27017/odontoscan
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/odontoscan
MONGO_URI=mongodb://localhost:27017/odontoscan

# JWT Secret — generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# AES Encryption Key — 32 characters exactly for AES-256
AES_KEY=your_32_character_encryption_key_here

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
